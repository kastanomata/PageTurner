<div class="club-card">
    <div class="club-header">
        <h2><%= club.name %></h2>
    </div>
    <div class="club-content" style="display: flex; gap: 1rem;">
        <div class="club-details">
            <% if club.description.present? %>
                <p class="description"><%= truncate(club.description, length: 150) %></p>
            <% end %>
            
            <div class="club-meta">
                <% if club.curator %>
                    <p>Curated by <%= link_to club.curator.nickname, user_path(club.curator) %></p>
                <% end %>
                
                <p>
                    <%= pluralize(club.members_count, 'member') %> •
                    <%#= pluralize(club.bookshelves_count, 'bookshelf') %>
                </p>
                
                <%# if club.location.present? %>
<!--                    <p><%#= club.location %></p>-->
                <%# end %>
            </div>

            <p>
                <%= link_to "Visit club", club_path(club), class: "btn btn-primary" %>
            </p>
        </div>
    </div>
</div>