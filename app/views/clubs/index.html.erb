<% content_for :title, "Clubs" %>
<style>
  body.clubs-index {
    background-image: url(<%= asset_path('index_backgrounds/clubs_background.jpg') %>);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed; /* Optional: keeps image fixed during scrolling */
    min-height: 100vh;
  }

  h1 {
    background-color: #ffffff;
    font-size: 4rem;
    margin-left: 35rem;
    margin-right: 35rem;
    color: #1f2937;
    border-radius: 4px;
    text-align: center;
  }
</style>

<h1>Clubs</h1>

<div id="clubs">
  <div class="club-index-container">
    <% @clubs.each do |club| %>
      <div class="club-index-element">
        <div class="club-card-container">
          <%= render partial: "clubs/club_card", locals: { club: club } %>
        </div>

      <div class="reading-goal-container">
        <%= render partial: "reading_goals/reading_goal_card",
                  locals: { current_reading_goal: ReadingGoal.current_for_club(club) } %>
      </div>

        <div class="event-container">
          <% upcoming_event = club.next_event %>
          <% if upcoming_event.present? %>
            <div class="upcoming-event">
              <%= render partial: 'events/event_card', locals: { event: upcoming_event } %>
            </div>
          <% else %>
            <div class="upcoming-event no-event">
              <h3>Upcoming Event</h3>
              <p><em>No upcoming events for this club...</em></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>