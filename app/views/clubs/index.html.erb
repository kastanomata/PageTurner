<% content_for :title, "Clubs" %>
<style>
  .upcoming-event {
    border: 2px solid #1f2937;
    height: 100%;
    padding: 1rem;
    margin: 16px 0;
    background-color: #f9f9f9;
    box-shadow: 0 2px 4px #1f2937;
    border-radius: 8px;
  }

  .current-goal {
    border: 2px solid #1f2937;
    height: 100%;
    padding: 1rem;
    margin: 16px 0;
    background-color: #f9f9f9;   
    box-shadow: 0 2px 4px #1f2937;
    border-radius: 8px;
  }

  .upcoming-event h3 {
    color: #1f2937;
    margin-top: 0;
    margin-bottom: 15px;
    font-size: 1.2rem;
  }

  @media (max-width: 768px) {  
    .upcoming-event {
      border-left: none;
      border-top: 2px solid #1f2937;
      padding-left: 0;
      padding-top: 20px;
    }
  }

</style>

<h1>Clubs</h1>

<div id="clubs">
  <% @clubs.each do |club| %>
    <div class="club-cards-container" style="display: flex; gap: 2rem; margin-left: 2rem; margin-right: 2rem; align-items: flex-start;">
      <%= render partial: "clubs/club_card",
              locals: {
                club: club
              }
      %>

      <% current_reading_goal = club.reading_goals.first %>
      <% unless current_reading_goal.blank? %>
        <div class="current-goal" style="flex: 1;">  
          <!--TODO put here current reading target-->
        </div>
      <% else %>
        <div class="current-goal no-goal">
          <p> <em> No current reading goal...</em> </p>
        </div>
      <% end %>

      <% upcoming_event = club.next_event %>
      <% unless upcoming_event.blank? %>
        <div class="upcoming-event">
          <%= render partial: 'events/event_card', locals: { event: upcoming_event } %>
        </div>
      <% else %>
        <div class="upcoming-event no-event">
          <p> <em> No upcoming events for this club...</em> </p>
        </div>
      <% end %>


    </div>
  <% end %>
</div>

