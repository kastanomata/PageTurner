<%= form_with(model: club, class: "cl-editor-form") do |form| %>
  <% if club.errors.any? %>
    <div class="cl-editor-validation">
      <h2 class="cl-editor-validation-title">
        <%= pluralize(club.errors.count, "error") %> prohibited this club from being saved:
      </h2>
      <ul>
        <% club.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="cl-editor-group">
    <%= form.label :name, class: "cl-editor-label" %>
    <%= form.text_field :name, class: "cl-editor-input" %>
  </div>

  <div class="cl-editor-group">
  <%= form.label :description, class: "cl-editor-label" %>
  <%= form.text_area :description, class: "cl-editor-input-textarea", rows: 4 %>
</div>

  <div class="cl-editor-actions">
    <%= form.submit class: "btn btn--secondary btn--sm" %>
  </div>
<% end %>