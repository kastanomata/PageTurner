<style>
  .form-container--login {
    width:30%;
  }

  .form-group--login {
    width:60%;
  }

  .form-actions--password {
    display: flex;
    flex-direction: column;
  }

  .btn--forgot-password {
    font-size:1rem;
    padding-bottom: 1rem;
  }

</style>

<div class="form-container form-container--login">
  <%= form_with url: session_path, class: "sign-in-form" do |form| %>
    <h1 class="form-title">Sign in</h1>
    <p class="form-subtitle">Welcome back! Please sign in to your account.</p>

    <div class="form-group form-group--login">
      <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address] %>
    </div>

    <div class="form-actions form-actions--password">
      <div class="form-group form-group--login">
        <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %>
      </div>
      <div style="text-align: center;">
          <%= link_to "Forgot password?", new_password_path, class: "btn btn--link btn--forgot-password" %>
      </div>
    </div>

    <div class="form-actions" >
      <div class="form-group">
        <%= form.submit "Sign in", class: "btn btn--primary btn--lg" %>
      </div>
  <% end %>

      <div class="form-group">
        <%= form_tag "/auth/google_oauth2", method: :post, data: { turbo: false } do %>
          <button type="submit" class="btn btn--secondary btn--lg">
            Login with Google
          </button>
        <% end %>
      </div>
    </div>
</div>
    <%# if Rails.env.development? %>
      <%#= form_tag "/auth/developer", method: :post, data: { turbo: false } do %>
<!--        <button type="submit" class="btn btn--secondary">
          Login with Developer
        </button>
      <%# end %>-->
    <%# end %>