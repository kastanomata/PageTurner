<!DOCTYPE html>
<style>
body.book-index {
  background-image: url(<%= asset_path('bookshelf_background.jpg') %>);
  background-repeat: repeat-y;  /* This makes it repeat vertically */
  background-size: 100% auto;   /* This makes the image fill the width while maintaining aspect ratio */
  background-attachment: fixed; /* Optional: makes the background fixed while scrolling */
  min-height: 100vh;
}

</style>
<html>
  <head>
    <title><%= content_for(:title) || "Page Turner" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/PageTurner.jpg" type="image/jpg">
    <link rel="apple-touch-icon" href="/PageTurner.jpg">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>

  <!--DO NOT REMOVE: This avoids janky behaviour of browser when stylesheets are not loaded-->
  <script>0</script>
  <!--DO NOT REMOVE-->
  
  <body class="<%= 'book-index' if current_page?(books_path) %>">
  <% unless controller.controller_name == 'errors' %>
    <%= render "layouts/navbar" %>
  <% end %>
  <%= tag.div(flash[:alert], class: "flash-message alert") if flash[:alert] %>
  <%= tag.div(flash[:notice], class: "flash-message notice") if flash[:notice] %>
  <div style='margin-bottom: 3rem;'>
    <%= yield %>
  </div>
  <%= render "layouts/footer" %>
  </body>
</html>
