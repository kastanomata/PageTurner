<footer class="footer">
    <div class="footer-content">
        <div class="footer-action">
            <% unless authenticated? %>
                <p class="footer-message">Want to join the club? <%= link_to "Register your account now!", new_user_path, class: "footer-register-link" %></p>
            <% else %>
                <p class="footer-message"> A project by Alfredo Segala, Alessandro Temperini e Antonio Turco </p>
            <% end %>
        </div>
        <div class="footer-links">
            <% if admin? %>
                <%= link_to "Reports", reports_path, class: "footer-link #{'active' if current_page?(reports_path)}" %>
                <%= link_to "Users", users_path, class: "footer-link #{'active' if current_page?(users_path)}" %>
                <%= link_to 'Manage Curator Icons', admin_curator_icons_path, class: 'footer-link' %>
            <% end %>
        </div>
        <div class="footer-brand">
            <%= link_to "PageTurner", root_path, class: "footer-logo" %>
        </div>
    </div>
</footer>
