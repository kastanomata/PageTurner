<div class="post-poster" style="text-align: center;">
    <%= link_to book_path(book), class: "book-link" do %>
        <% if book.poster.present? %>
            <%= image_tag book.poster, alt: "Cover of #{book.title}" %>
        <% else %>
            <%= image_tag "bookart_not_found.png", alt: "poster not found", style: "display: block; margin: 0 auto; width: auto; height: 150;" %>
        <% end %>
    <% end %>
</div>