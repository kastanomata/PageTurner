<!-- 
  This is the show page for a single book
  It displays the book's title, ISBN, and cover image 
  if those information are available, otherwise it makes a 
  request to the openlibrary API to get the book's information
  and saves it in the database
-->

<div class="book-card">
  <h1>
    <%= @book.title %>
  </h1>
  <%= book_image @book, size: "poster"%>
  <p>ISBN: <%= @book.isbn %></p>

  <%= add_book_to_bookshelf_buttons @book %>
  <%= set_book_as_reading @book %>
</div>

<div class="book-info-container">
  <%= render 'authors/author_card', author: @book.author %>
  <%= render_popular_tags(@book.tags) %>
</div>

<div>
  <%= link_to "Back to books", books_path %>
</div>

<div class="button_container">
  <% if Current.user&.admin? %>
    <div style="display: flex; gap: 10px;">
      <%= link_to "Edit this book", edit_book_path(@book), class: "button" %>
      <%= button_to "Destroy this book", @book, method: :delete, class: "button" %>
    </div>
  <% end %>
</div>