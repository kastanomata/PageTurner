

<% content_for :title, "Books" %>

<h1>Books</h1>

<div class="books-container">
  <% @books.each do |book| %>
    <div class="book-card">
      <%= book_image book %>
      <h3><%= book.title %></h3>
      <p>ISBN: <%= book.isbn %></p>
      <%= link_to "View Details", book_path(book), class: "btn btn--primary" %>
    </div>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
