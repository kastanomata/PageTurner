<% content_for :title, "Books" %>
<style>
  h1 {
    background-color: #ffffff;
    font-size: 4rem;
    margin-left: 40rem;
    margin-right: 40rem;
    color: #1f2937;
    border-radius: 4px;
    text-align: center;
  }
</style>
<h1> Books</h1>

<div class="books-container">
  <% @books.each do |book| %>
    <%= render 'books/book_card',
      book: book,
      show_title: true, 
      show_hover_info: false do %>
      
      <p>ISBN: <%= book.isbn %></p>
      <%= link_to "View Details", book_path(book), class: "btn btn--secondary" %>
    <% end %>
  <% end %>
</div>