<% content_for :title, "Authors" %>
<style>
  body.authors-index {
    background-image: url(<%= asset_path('index_backgrounds/authors_background.jpg') %>);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed; 
    min-height: 100vh;
  }

  h1 {
    background-color: #ffffff;
    font-size: 4rem;
    margin-left: 35rem;
    margin-right: 35rem;
    color: #1f2937;
    border-radius: 4px;
    text-align: center;
  }
</style>

<h1>Authors</h1>

<div id="authors" class="authors-grid">
  <% @authors.each do |author| %>
    <div class="authors-grid-item">
      <div class="author-card-column">
        <%= render partial: 'authors/author_card', locals: { author: author } %>
      </div>
      
      <div class="event-card-column">
        <% upcoming_event = author.events.upcoming.first %>
        <% if upcoming_event %>
          <%= render partial: 'events/event_card', locals: { event: upcoming_event } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<div class="new-author-link">
  <%= link_to "New author", new_author_path, class: "btn btn-primary" %>
</div>
