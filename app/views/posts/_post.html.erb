<div class="postcard">
  <div class="postcard-left">
    <div class="postcard-image-container">
      <% if @post.book %>
        <%= book_image @post.book, size: "poster" %>
      <% end %>
    </div>
  </div>
  <div class="postcard-right"> 
    <div class="post-header">
      <h1><%= @post.title %></h1>
    </div>
      
    <div class="post-content" style="flex: 2;">
      <p><%= @post.text %></p>
    </div>
      
    <div class="post-actions" style="flex: 2;">
      <%= display_likes_count @post %>
      <%= like_button @post %>
    </div>
  </div>
</div>

<div style="display:flex; flex-direction:row; gap:1rem;">
  <div>
    <%= render_report_button @post %>
  </div>
  <div>
    <% if @post.club.present? and Current.user == @post.club.curator %>
      <%= button_to "Remove from Club", 
          remove_post_club_path(id: @post.club.id, post_id: @post.id), 
          method: :delete, 
          class: "btn btn--negative btn--sm",
          form: { data: { turbo_confirm: "Are you sure?" } } %>
    <% end %>
  </div>
</div>
