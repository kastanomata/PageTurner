

  <div class="postcard">
    <div class="postcard-left">
      <div class="postcard-image-container">
        <% if @post.book %>
          <%= book_image @post.book, size: "poster" %>
        <% end %>
      </div>
    </div>
    <div class="postcard-right"> 
        
      <div class="post-content">
        <p><%= @post.text %></p>
      </div>
        
      <div class="display-like">
        <%= display_likes_count @post %>
      </div>
    </div>
  </div>

  <div class="post-actions">
    <%= like_button @post %>
    <%= render_report_button @post %>
  </div>
