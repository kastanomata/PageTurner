

  <div class="postcard">
    <div class="postcard-left">
      <div class="postcard-image-container">
        <% if @post.book %>
          <%= render partial: "books/poster", locals: { book: @post.book }, class: "book-image" %>
        <% end %>
      </div>
    </div>
    <div class="postcard-right"> 
      <div class="post-header">
        <h1><%= @post.title %></h1>
    
        <div class="post-meta" style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
          <p>Posted by: <%= link_to @post.author.nickname, user_path(@post.author) %></p>
          <!--# TODO add support for absent post author-->
          <%# if @post.author %> 
          <%# else %>
          <!--      <p>Posted by: <em>[User not found]</em></p>-->
          <%# end %>
        </div>
      </div>
        
      <div class="post-content" style="flex: 2;">
        <p><%= @post.text %></p>
      </div>
        
      <div class="post-actions" style="flex: 2;">
        <%= display_likes_count @post %>
        <%= like_button @post %>
      </div>
    </div>
  </div>

  <div>
    <%= render_report_button @post %>
  </div>
