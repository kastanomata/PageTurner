<%= form_with(model: post, class: "post-editor-form") do |form| %>
  <% if post.errors.any? %>
    <div class="post-editor-validation">
      <h2 class="post-editor-validation-title">
        <%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:
      </h2>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="post-editor-group">
    <%= form.label :title, class: "post-editor-label" %>
    <%= form.text_field :title, class: "post-editor-input" %>
  </div>

  <div class="post-editor-group">
    <%= form.label :text, class: "post-editor-label" %>
    <%= form.text_area :text, class: "post-editor-input-textarea", rows: 4 %>
  </div>

  <div class="post-editor-actions">
    <%= form.submit class: "btn btn--secondary btn--sm" %>
<% end %>
    <%= button_to "Destroy this post", @post, method: :delete, class:"btn btn--negative btn--sm" %>

  </div>

