<% content_for :title, "New post" %>

<div class="postcard-container">
  <div class="post-header">
    New Post
  </div>
  <div class="postcard">
    <!-- Lato sinistro -->
    <div class="postcard-left">
      <div class="book-image-container">
        <img src="book.jpg" alt="Book Cover" class="book-image">
      </div>
    </div>

    <!-- Lato destro -->
    <div class="postcard-right">
      
      <div class="postcard-form-container">
        <form>
           <%= render "form", post: @post %>
        </form>
      </div>
    </div>
  </div>

    <div class="back-link">
      <%= link_to "Back to posts", posts_path, class: "btn--link" %>
    </div>

</div>