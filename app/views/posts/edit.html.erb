<% content_for :title, "Editing post" %>

<div class="post-editor-container">
  <h1 class="post-editor-title">Editing post</h1>
  
  <div class="post-editor-form-wrap">
    <%= render "form", post: @post %>
  </div>

  <div>
    <%= link_to "Show this post", @post, class: "post-editor-link" %>
  </div>
</div>
