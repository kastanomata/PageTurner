<div class="post-card">
    <div class="post-header">
        <h2> <%= link_to post.title, post_path(post), class: "btn btn--link post-title"%> </h2>
    </div>
    <div class="post-content" style="display: flex; gap: 1rem;">
        <div class="cover">
            <%= book_image post.book %>
        </div>
        <div class="post-details">
            <p><%= post.text %></p>
            <% if post.club %>
                <p> Posted by <%= link_to post.author.nickname, user_path(post.author), class: "btn btn--link" %> in the <%= link_to post.club.name, club_path(post.club), class: "btn btn--link" %> club. </p>
            <% else %>
                <p> Posted by <%= link_to post.author.nickname, user_path(post.author), class: "btn btn--link" %> </p>
            <% end %>
        </div>
    </div>
</div>