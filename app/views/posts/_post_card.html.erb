<div class="post-card">
    <div class="post-header post-header--postcard">
        <h2> <%= link_to post.title, post_path(post), class: "btn btn--link post-title"%> </h2>
        <%= post_card_header(post) %>
    </div>
    <div class="post-content" style="display: flex; gap: 1rem;">
        <% unless local_assigns[:no_cover] %>
            <div class="cover">
                <%= link_to book_path(post.book), title: post.book.title, data: { toggle: "tooltip" } do %>
                <%= book_image post.book %>
                <% end %>
            </div>
        <% end %>
        <div class="post-text">
            <p><%= post.text %></p>
        </div>
    </div>
    <div class="post-stats">
        <span class="post-stat">
            <%= pluralize(post.comments.count, 'comment') %>
        </span>
        <span class="post-stat">
            <%= pluralize(post.likes.count, 'like') %>
        </span>
    </div>
</div>