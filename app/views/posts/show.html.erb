<div class="post-header-container">
  <h1><%= @post.title %></h1>
    
  <p>Posted by: <%= link_to @post.author.nickname, user_path(@post.author) %></p>
    <!--# TODO add support for absent post author-->
    <%# if @post.author %> 
    <%# else %>
    <!--      <p>Posted by: <em>[User not found]</em></p>-->
    <%# end %>
</div>

<div class="a">
  <div class="post-show-container">
   

    <div class="postcard-container">
      <%= render @post %>

      <div class="admin-action", style="margin-top: 20px;">
        <% if Current.user&.admin? %>
          <%= button_to "Destroy this post", @post, method: :delete, class:"button" %>
        <% end %>
        <% if @post.author == Current.user %>
          <%= link_to "Edit Post", edit_post_path(@post), class: "btn btn--secondary btn--sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="comment-container">
      <h3>Comments</h3>

      <div class="comments-scrollable">
        <% unless @post.comments.present? %>
          <p>No comments yet.</p>
        <% else %>
          <% @post.comments.each do |comment| %>
            <% # log_star comment.inspect %>
            <% if comment[:author_id].present? %>
              <div class="comment">
                <span><strong><%= User.find(comment[:author_id]).nickname %>:</strong></span>
                <span><%= comment.text %></span>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% if authenticated? %>
        <div class="comment-form">
          <%= render "comments/form", comment: @comment %>
        </div>
      <% else %>
        <div class="comment-form">
          <%= link_to "Log in to comment!", login_path %>
        </div>
      <% end %>
    </div>
  </div>
</div>
