

<% content_for :title, "#{@event.title}" %>

<div class="event-page-container">
  <div class="event-main-content">
    <!-- Contenuto principale dell'evento -->
    <div class="event-card">
      <%= render @event %>
    </div>

    <!-- Sezione azioni (solo per owner/admin) -->
    <% if Current&.user == @event.organizer || Current.user&.admin? %>
      <div class="event-actions">
        <%= link_to "Edit this event", edit_event_path(@event), class: "btn btn--secondary btn--md" if Current&.user == @event.organizer %>
        <%= button_to "Destroy this event", @event, method: :delete, class: "btn btn--negative btn--md" %>
      </div>
    <% end %>
  </div>

  <!-- Sidebar con info organizzatore -->
  <aside class="event-sidebar">
    <% if @event.organizer_object.is_a?(Club) %>
      <%= render 'clubs/club_card', club: @event.organizer_object %>
    <% elsif @event.organizer_object.is_a?(Author) %>
      <%= render 'authors/author_card', author: @event.organizer_object %>
    <% end %>
  </aside>
</div>