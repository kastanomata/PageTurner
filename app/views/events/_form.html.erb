

<%= form_with(model: event) do |f| %>
  <div class="form-container">
    <% if event.errors.any? %>
      <div class="form-errors">
        <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
        <ul>
          <% event.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @organizer_options.size > 1 %>
      <div class="form-group">
        <h3>Organize as:</h3>
        <% @organizer_options.each do |organizer| %>
          <div class="form-check">
            <%= radio_button_tag :organizer_type, organizer.class.name, organizer == event.organizer_object,
                  class: "form-check-input", id: "organizer_#{organizer.class.name.downcase}" %>
            <%= label_tag "organizer_#{organizer.class.name.downcase}", 
                  "#{organizer.name} (#{organizer.class.name})", class: "form-check-label" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= hidden_field_tag :organizer_type, @organizer_options.first.class.name %>
      <%= hidden_field_tag :organizer_id, @organizer_options.first.id %>
    <% end %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :description %>
      <%= f.text_area :description, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :start_time %>
      <%= f.datetime_local_field :start_time, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :end_time %>
      <%= f.datetime_local_field :end_time, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :book_id, "Associated Book" %>
      <%= f.hidden_field :book_id, id: "event_book_id" %> <%# Added explicit ID %>
      
      <div class="isbn-input-container">
        <input type="text" 
              class="form-control isbn-input" 
              placeholder="Search by ISBN..."
              data-search-url="<%= search_books_path %>"
              data-fetch-url="<%= fetch_books_path %>"
              id="isbn-search-input"> <%# Added ID for easier selection %>
        <div class="search-results" id="isbn-search-results"></div>
      </div>
      
      <div class="book-preview mt-2">
        <%= image_tag "", 
              id: "book-cover-preview", 
              class: "book-cover-preview",
              data: { fallback: image_path('bookart_not_found.png') } %>
        <div id="book-title-preview"></div>
        <div id="book-author-preview"></div> <%# Added author preview %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit class: "btn btn-primary" %>
      <%= link_to 'Cancel', events_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<script>
  function updateBookDetails(book) {
    // Clear previous values
    bookIdInput.value = '';
    bookTitlePreview.textContent = '';
    document.getElementById('book-author-preview').textContent = '';
    bookCoverPreview.src = '';

    if (book.id) {
      bookIdInput.value = book.id;
    }
    
    if (book.title) {
      bookTitlePreview.textContent = book.title;
    }
    
    if (book.author) {
      document.getElementById('book-author-preview').textContent = `by ${book.author}`;
    }
    
    if (book.cover_url || book.isbn) {
      const coverUrl = book.cover_url || `https://covers.openlibrary.org/b/isbn/${book.isbn}-M.jpg`;
      bookCoverPreview.src = coverUrl;
      bookCoverPreview.onerror = () => {
        bookCoverPreview.src = bookCoverPreview.dataset.fallback;
      };
    }
  }

  async function fetchFromOpenLibrary(isbn) {
    try {
      const response = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`);
      const data = await response.json();
      
      if (!data || !data[`ISBN:${isbn}`]) {
        throw new Error('Book not found in OpenLibrary');
      }
      
      const bookData = data[`ISBN:${isbn}`];
      return {
        title: bookData.title,
        isbn: isbn,
        cover_url: bookData.cover?.medium || `https://covers.openlibrary.org/b/isbn/${isbn}-M.jpg`,
        author: bookData.authors?.[0]?.name || 'Unknown Author'
      };
    } catch (error) {
      console.error('Error fetching from OpenLibrary:', error);
      return null;
    }
  }

  // Updated search handler
  const searchHandler = debounce(async (query) => {
    controller?.abort();
    controller = new AbortController();

    try {
      const response = await fetch(`${isbnInput.dataset.searchUrl}?query=${encodeURIComponent(query)}`, {
        signal: controller.signal
      });
      
      if (!response.ok) throw new Error('Search failed');
      
      const books = await response.json();
      
      searchResults.innerHTML = books.map(book => `
        <div class="book-result" 
            data-isbn="${book.isbn}"
            data-title="${book.title}"
            data-id="${book.id}"
            data-cover="${book.cover_url}">
          <img src="${book.cover_url || bookCoverPreview.dataset.fallback}" 
              class="result-cover">
          <div class="result-info">
            <div class="result-title">${book.title}</div>
            <div class="result-isbn">ISBN: ${book.isbn}</div>
          </div>
        </div>
      `).join('');
    } catch (error) {
      if (error.name !== 'AbortError') {
        searchResults.innerHTML = `<div class="error">Error searching books: ${error.message}</div>`;
      }
    }
  }, 300);

  // Updated fetch handler
  const fetchHandler = debounce(async (isbn) => {
    try {
      // First try local database
      const localResponse = await fetch(`${isbnInput.dataset.fetchUrl}?isbn=${encodeURIComponent(isbn)}`);
      
      if (localResponse.ok) {
        const book = await localResponse.json();
        updateBookDetails(book);
        return;
      }
      
      // Fall back to OpenLibrary
      const bookData = await fetchFromOpenLibrary(isbn);
      if (!bookData) {
        searchResults.innerHTML = `<div class="error">Book not found in any sources</div>`;
        return;
      }
      
      searchResults.innerHTML = `
        <div class="book-result">
          <img src="${bookData.cover_url}" 
              class="result-cover">
          <div class="result-info">
            <div class="result-title">${bookData.title}</div>
            <div class="result-author">by ${bookData.author}</div>
            <button class="btn btn-primary create-book-btn"
                    data-isbn="${bookData.isbn}">
              Add this book to database
            </button>
          </div>
        </div>
      `;
    } catch (error) {
      searchResults.innerHTML = `<div class="error">Error fetching book details: ${error.message}</div>`;
    }
  }, 500);

  // Updated createBook function
  async function createBook(isbn) {
    try {
      const bookData = await fetchFromOpenLibrary(isbn);
      if (!bookData) throw new Error('Invalid book data');
      
      const response = await fetch('/books', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        },
        body: JSON.stringify({
          book: {
            isbn: isbn,
            title: bookData.title,
            cover: bookData.cover_url,
            author_attributes: {
              name: bookData.author
            }
          }
        })
      });
      
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || 'Failed to create book');
      }
      
      const newBook = await response.json();
      updateBookDetails(newBook);
      isbnInput.value = newBook.isbn; // Update input with actual ISBN from database
      searchResults.innerHTML = `<div class="success">Book added successfully!</div>`;
    } catch (error) {
      searchResults.innerHTML = `<div class="error">Error creating book: ${error.message}</div>`;
    }
  }
</script>