<div>
  <div class="split-container">
    <div class="left-column">
      <div class="user-info">
        <h1><%= @user.nickname %></h1>
        <% if @user.avatar.attached? %>
          <div>
            <%= image_tag url_for(@user.avatar), alt: "Foto Profilo" %>
            <%= button_to "Rimuovi Foto", remove_avatar_user_path(@user), method: :delete, data: { confirm: "Sei sicuro di voler rimuovere la foto?" } %>
          </div>
        <% end %>
        <%= link_to 'Change Backgrounds', background_settings_user_path(@user), class: 'nav-link' %>
        <section class="stats">
              <%= render_user_relationships_widget @user%>
        </section>
      </div>
      <div class="btn--link">
        <%= render_report_button @user %>
        <%= user_ban_status @user %>
        <%= link_to "Edit your profile", edit_user_path(@user), class: "btn btn--secondary btn--sm" if current_user_owns? @user%>
      </div>
    </div>   
    <div class="right-column">
      <%= user_description @user  %>
      <%= currently_reading @user %>  
    </div>
    <div class="curator-info">
      <% if @user.curator_icon %>
        <%= image_tag @user.curator_icon.icon, class: 'curator-icon' %>
      <% else %>
        <div class="default-icon">👤</div>
      <% end %>
    </div>
  </div>

<h3>Suggested Books</h3>
  <!-- FIXME fix user suggested book not working -->
  <% @user.suggested_books.each do |book| %>
    <%= render 'books/cover', book: book %>
  <% end %>

  <div class="user-content">
    <div class="bookshelves bookshelves--user">
      <h2>Bookshelves
      <% if Current.user&.id == @user.id%>
        <%= link_to new_bookshelf_path, class: "new-post-btn" do %>
         <span class="footer-button-container plus-icon">+</span>
        <% end %>
      <% end %>
      </h2>
      <%= render_user_bookshelves @user %>
    </div>

    <div class="posts posts--user">
      <h2>Posts
        <% if Current.user&.id == @user.id%>
          <%= link_to new_post_path, class: "new-post-btn" do %>
           <span class="footer-button-container plus-icon">+</span>
          <% end %>
        <% end %>
      </h2>
      <%= render "shared/postcard_form" %>
      <%= render_user_posts @user %>
    </div>

  </div>

</div>
