<div>
  <% unless (@user&.background_theme || 'default') == 'default' %>
    <div  style="<%= 'background-color: #ffffff;' if (@user&.background_theme || 'default') == 'default' %>
              <%= "background-image: url('#{asset_path("#{@user&.background_theme}.jpg")}');" unless (@user&.background_theme || 'default') == 'default' %>
              background-size: cover;
              background-position: center;
              background-attachment: fixed;
              background-repeat: no-repeat;
              position: relative;
              min-height: 25vh;
              display: flex;
              gap: 2rem;
              padding: 2rem;">
    </div>
  <% end %>
  <div class="split-container">
    <div class="left-column">
      <div class="user-info">
        <h1><%= @user.nickname %></h1>
        <% if @user.avatar.attached? %>
          <div>
            <%= image_tag url_for(@user.avatar), alt: "Foto Profilo", class: "book-image book-image--cover" %>
          </div>
        <% end %>
        <section class="stats">
              <%= render_user_relationships_widget @user%>
        </section>
      </div>
      <%= user_ban_status @user %>
      <div style="display:flex; flex-direction:row; gap:5px; margin:5px;">
        <%= render_report_button @user %>
        <% if @user.is_author? %>
          <%= button_to "Create Event", new_event_path(user_id: @user), method: :get, class: "btn btn--primary btn--sm" %>
        <% end %>
        <%= link_to "Edit your profile", edit_user_path(@user), class: "btn btn--secondary btn--sm" if current_user_owns? @user%>
      </div>
    </div>   
    <div class="right-column">
      <%= user_description @user  %>
      <%= currently_reading @user %>  
    </div>
    <div class="curator-info">
      <% if @user.is_curator == true%>
        <% if @user.curator_icon %>
          <%= image_tag @user.curator_icon.icon, class: 'curator-icon' %>
        <% else %>
          <div class="default-icon">👤</div>
        <% end %>
      <% end %>
    </div>
  </div>


  <div class="user-content">
    <div class="bookshelves bookshelves--user">
      <h2>Bookshelves
      <% if Current.user&.id == @user.id%>
        <%= link_to new_bookshelf_path, class: "new-post-btn" do %>
         <span class="footer-button-container plus-icon">+</span>
        <% end %>
      <% end %>
      </h2>
      <%= render_user_bookshelves @user %>
    </div>

    <div class="posts posts--user">
      <h2>Posts
        <% if Current.user&.id == @user.id%>
          <%= link_to new_post_path, class: "new-post-btn" do %>
           <span class="footer-button-container plus-icon">+</span>
          <% end %>
        <% end %>
      </h2>
      <% if Current.user == @user %>
        <%= render "shared/postcard_form" %>
      <% end %>

      <div class="suggested-row"> 
        <h3>Suggested Books</h3>
          <div style="display: flex; gap:5px;">
            <% @user.suggested_books.each do |book| %>
              <%= render 'books/cover', book: book %>
            <% end %>
          </div>
      </div>

      <div>
        <%= render_user_posts @user %>
      </div>
  
    </div>

  </div>

</div>
