<p style="color: green"><%= notice %></p>

<div>
  <div class="split-container">
    <div class="left-col">
      <div class="user-info">
        <h1><%= @user.nickname %></h1>
        <%= link_to "Edit this user", edit_user_path(@user), class: "btn-link" if Current.user&.admin? or current_user_owns?(@user)%>
        
        <section class="stats">
              <%= render_user_relationships_widget @user%>
        </section>
      </div>
      <div class="btn-link">
        <%= render_report_button @user %>
      </div>
    </div>   
    <div class="righ-col">
      <div class="user-description"><%= @user.description %></div>
    </div>
  </div>


  <div class="user-content" style="display: flex; gap: 20px;">
    <div class="bookshelves" style="flex: 1;">
      <h2>Bookshelves
      <% if Current.user&.id == @user.id%>
        <%= link_to new_bookshelf_path, class: "new-post-btn" do %>
         <span class="footer-button-container plus-icon">+</span>
        <% end %>
      <% end %>
      </h2>
        <%= render_user_bookshelves @user %>
      </div>
    </div>

    <div class="posts" style="flex: 1;">
      <h2>Posts
      <% if Current.user&.id == @user.id%>
        <%= link_to new_post_path, class: "new-post-btn" do %>
         <span class="footer-button-container plus-icon">+</span>
        <% end %>
      <% end %>
      </h2>
        <%= render_user_posts @user %>
    </div>
  </div>
</div>
