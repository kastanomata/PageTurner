<style>
  .form-group--nickname {
    width: 30%
  }

  .form-group--description {
    width: 60%;
    font-family: Garamond, serif;
  }

  .form-group--birthday {
    width: 18%
  }
</style>

<%= form_with(model: user, class: "form-container-update-user") do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group form-group--nickname">
    <%= form.label :nickname, class: "form-label" %>
    <%= form.text_field :nickname, 
          class: "form-control", 
          required: true,
          placeholder: "Enter your nickname" %>
  </div>

  <div class="form-group form-group--description">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, 
          class: "form-control", 
          rows: 4,
          style: "resize: none",
          placeholder: "Tell us about yourself" %>
  </div>

  <div class="form-group form-group--birthday">
    <%= form.label :birthday, class: "form-label" %>
    <%= form.date_field :birthday, 
          class: "form-control" %>
  </div>

<% if form.object.is_curator? %>
  <div class="field">
    <%= form.label :curator_icon_id %>
    <%= form.collection_select :curator_icon_id,
                              CuratorIcon.all,
                              :id,
                              :name,
                              { include_blank: 'No icon' } %>
  </div>
<% end %>

  <div>
    <%= link_to 'Change Backgrounds', background_settings_user_path(@user), class: 'nav-link' %>
  </div>
  
  <% if not @user.avatar.attached? %>
    <div class="form-group">
      <%= form.label :avatar, "Profile Photo", class: "form-label" %>
      <%= form.file_field :avatar, 
            class: "form-control-file" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= link_to "Change Password", 
          new_password_path, 
          class: "btn btn--link" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save Changes", class: "btn btn--affirmative btn--md" %>
    <%= link_to "Discard Changes", user_path(@user), class:"btn btn--secondary btn--md"%>
<% end %>
    <% if @user.avatar.attached? %>
      <%= button_to "Rimuovi Foto", remove_avatar_user_path(@user), method: :delete, class: "btn btn--delete btn--sm", data: { confirm: "Sei sicuro di voler rimuovere la foto?" } %>
    <% end %>
    <%= button_to "Delete your account", user_path(user), method: :delete, class: "btn btn--negative btn--md"%>
  </div>