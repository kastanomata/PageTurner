<%= form_with(model: user, class: "form-container") do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :nickname, class: "form-label" %>
    <%= form.text_field :nickname, 
          class: "form-control", 
          required: true,
          placeholder: "Enter your nickname" %>
  </div>

  <div class="form-group">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, 
          class: "form-control", 
          rows: 4,
          style: "resize: none",
          placeholder: "Tell us about yourself" %>
  </div>

  <div class="form-group">
    <%= form.label :birthday, class: "form-label" %>
    <%= form.date_field :birthday, 
          class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :avatar, "Profile Photo", class: "form-label" %>
    <%= form.file_field :avatar, 
          class: "form-control-file" %>
  </div>

  <div class="form-group">
    <%= link_to "Change Password", 
          new_password_path, 
          class: "btn btn--link" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save Changes", class: "btn btn--primary" %>
<% end %>
    <%= button_to "Delete this user", user_path(user), method: :delete, class: "btn btn--negative"%>
  </div>