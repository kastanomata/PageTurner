<style>
  .container-edit {
    display: flex;
    margin: 0rem 2rem;
    flex-direction: row;
    gap: 2rem;
  }
  
  .edit-section {
    flex: 1;
  }
</style>

<% content_for :title, "Editing user" %>
<div class="container-edit">
  <div class="edit-section" style="flex:2;">
    <%= render "update", user: @user %>
  </div>
  
  <div class="edit-section">
    <%= make_author_request(@user) %>
  </div>
</div>