<div class="user-card">
  <div class="user-info">
    <%= user.nickname %> | <strong><%= user.email_address %></strong>
  </div>
  
  <div class="user-role">
    <%= render 'shared/roles', user: user %>
  </div>
  <div class="moderation-state">
    <%= user_ban_status(user) %>
  </div>

  <div class="user-actions">

    <%= link_to "Show this user", user_path(user), class: "btn btn--primary btn--sm" %>
    <%= ban_unban_button(user) %>
    
    <%= button_to "Delete this user", user_path(user), 
                method: :delete,
                data: { confirm: "Permanently delete #{user.nickname}?" },
                class: "btn btn--delete btn--sm" %>
  </div>
</div>