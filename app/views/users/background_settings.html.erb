<div class="container" data-controller="background">
  <h2>Book-themed Background Settings</h2>
    
  <%= form_with model: @user, 
               url: update_background_user_path(@user),
               data: { action: "submit->background#update" } do |f| %>
    <div class="theme-grid">
      <% User::BACKGROUND_THEMES.each do |key, config| %>
        <label class="theme-option" data-theme="<%= key %>">
          <%= f.radio_button :background_theme, key, 
                class: "theme-radio",
                data: { action: "click->background#preview" } %>
          
          <div class="theme-preview <%= 'default-theme' if key == 'default' %>">
            <% if key != 'default' %>
              <div class="theme-image" 
                   style="background-image: url('<%= asset_path("#{key}.jpg") %>')"></div>
            <% end %>
            <span class="theme-label"><%= key %></span>
          </div>
        </label>
      <% end %>
    </div>

    <%= f.submit "Save Theme", class: "btn btn-primary mt-3" %>
  <% end %>
</div>