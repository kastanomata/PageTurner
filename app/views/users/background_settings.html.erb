<div class="container">
  <h2>Book-themed Background Settings</h2>
  
  <%= form_with model: @user, url: update_background_user_path(@user),
        data: { 
               controller: "background",
               background_updater_theme_value: @user.background_theme
             } do |f| %>
    <% User::BACKGROUND_THEMES.each do |key, name| %>
      <label class="theme-option">
        <%= f.radio_button :background_theme, key, class: "theme-radio" %>
        <span class="theme-label"><%= name %></span>
        <div class="theme-preview <%= 'default-theme' if key == 'default' %>" 
             style="<%= key == 'default' ? 'background-color: #ffffff;' : "background-image: url('#{asset_path("#{key}.jpg")}');" %>">
        </div>
      </label>
    <% end %>

    <%= f.submit "Save Book Theme", class: "btn btn-primary mt-3" %>
  <% end %>
</div>

<style>
  <% User::BACKGROUND_THEMES.each_key do |key| %>
    <% next if key == 'default' %>
    .theme-preview.<%= key %> {
      background-image: url('<%= asset_path("#{key}.jpg") %>');
    }
    body[data-background-theme="<%= key %>"] {
      background-image: url('<%= asset_path("#{key}.jpg") %>');
    }
  <% end %>
</style>