<%# _form.html.erb %>
<%= form_with(model: bookshelf) do |form| %>
  <% if bookshelf.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(bookshelf.errors.count, "error") %> prohibited this bookshelf from being saved:</h2>
      <ul>
        <% bookshelf.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, autocomplete: "off" %>
  </div>

  <% if Current.user&.is_curator? %>
    <div>
      <%= form.label :link_to_club, "Link this bookshelf to the club?" %>
      <%= form.radio_button :link_to_club, true %> Yes
      <%= form.radio_button :link_to_club, false %> No
    </div>
  <% end %>

  <div class="form-container">
    <div id="isbn-fields-wrapper">
      <!-- I campi ISBN dinamici verranno inseriti qui -->
    </div>

    <div class="form-group">
      <%= form.submit "Submit", class: "btn-submit" %>
    </div>
  </div>
<% end %>


<script>
function initISBNForm() {
  const wrapper = document.getElementById('isbn-fields-wrapper');

  if (!wrapper) return;

  wrapper.addEventListener('input', function (e) {
    if (e.target.classList.contains('book-isbn')) {
      handleISBNInput(e.target);
    }
  });

  wrapper.addEventListener('click', function (e) {
    const resultItem = e.target.closest('.search-result-item');
    if (resultItem) {
      handleResultClick(resultItem);
    }
  });

  function handleISBNInput(input) {
    const isbn = input.value.trim();
    const resultsDiv = input.parentElement.querySelector('.search-results');

    if (isbn.length >= 7) {
      fetch(`/books.json?isbn=${encodeURIComponent(isbn)}`)
        .then(response => response.json())
        .then(books => {
          if (books.length > 0) {
            resultsDiv.innerHTML = `
              <div class="search-results-list">
                ${books.map(book => `
                  <div class="search-result-item" 
                       data-isbn="${book.isbn}"
                       data-title="${book.title}">
                    ${book.isbn} - ${book.title}
                  </div>
                `).join('')}
              </div>`;
          } else {
            resultsDiv.innerHTML = '<div class="no-results">No books found</div>';
          }
        });
    } else {
      resultsDiv.innerHTML = '';
    }
  }

  function handleResultClick(result) {
    const group = result.closest('.form-group');
    const isbnInput = group.querySelector('.book-isbn');
    const titleDisplay = group.querySelector('.book-title-display');

    isbnInput.value = result.dataset.isbn;
    titleDisplay.textContent = result.dataset.title;
    group.querySelector('.search-results').innerHTML = '';

    if (isLastInput(isbnInput)) {
      createISBNField();
    }
  }

  function createISBNField() {
    const newGroup = document.createElement('div');
    newGroup.className = 'form-group';
    newGroup.innerHTML = `
      <label class="form-label">ISBN</label>
      <input type="text" 
             class="form-control book-isbn" 
             name="bookshelf[book_isbns][]" 
             autocomplete="off" 
             placeholder="Enter ISBN">
      <div class="search-results"></div>
      <div class="book-title-display"></div>
    `;
    wrapper.appendChild(newGroup);
  }

  function isLastInput(input) {
    const inputs = wrapper.querySelectorAll('.book-isbn');
    return input === inputs[inputs.length - 1];
  }

  // Assicurati che almeno un campo ci sia
  if (wrapper.children.length === 0) {
    createISBNField();
  }
}

// Avvia lo script al momento giusto
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initISBNForm);
} else {
  initISBNForm(); // Esegui subito se il DOM è già pronto
}
</script>
