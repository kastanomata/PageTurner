<% 
  bookshelf_class = local_assigns[:class_name] || 'bookshelf'
  debug bookshelf_class
 %>
<div class="<%= bookshelf_class %>">
  <h3><%= link_to bookshelf.name, bookshelf, class: "btn-link" %></h3>
  <%= display_bookshelf_thumbnails bookshelf %>
  
  <% if local_assigns[:show_bookclub_info] && bookshelf.bookclub %>
    <p class="bookclub-info">
      <% club = Club.find(bookshelf.bookclub)%>
      Club: <%= link_to club.name, club_path(club) %>
    </p>
  <% end %>
</div>