<div class="<%= local_assigns[:class_name] || 'bookshelf' %>">
  <h3><%= bookshelf.name %></h3>
  <p>Created at: <%= bookshelf.created_at.strftime("%B %d, %Y") %></p>
  
  <% if local_assigns[:show_bookclub_info] && bookshelf.bookclub %>
    <p class="bookclub-info">
      <% club = Club.find(bookshelf.bookclub)%>
      Club: <%= link_to club.name, club_path(club) %>
    </p>
  <% end %>
  
  <%= link_to "Show this bookshelf", bookshelf, class: "btn-link" %>
</div>