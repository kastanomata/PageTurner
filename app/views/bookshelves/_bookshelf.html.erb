<div id="<%= dom_id bookshelf %>">
<% if local_assigns[:index] %>
  <div class="bookshelf-index">
<% else %>
  <div class="bookshelf">
<% end %>
    <div class="bookshelf-content">
      <div class="bookshelf-header">
        <h2 class="bookshelf-title"><%= link_to bookshelf.name, bookshelf_path(bookshelf), class: "btn btn--link" %></h2>
        <p class="bookshelf-creator">Created by: <%= link_to bookshelf.creator.nickname, user_path(bookshelf.creator), class: "btn btn--link" %></p>
      </div>
    <% if local_assigns[:index] %>
      <div class="bookshelf-tags">
        <% if bookshelf.top_tags.any? %>
          <div class="tag-list">
            <% bookshelf.top_tags.each do |tag| %>
              <span class="tag"><%= tag.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="no-tags">No tags yet</p>
        <% end %>
      </div>
    <% end %>
    </div>

    <div class="bookshelf-books-container">
      <% bookshelf.bookshelf_contains.includes(:book).each do |contain| %>
        <% book = contain.book %>
        <% next unless book %>
        
        <%= render 'books/book_card', 
          book: book,
          current_user: bookshelf.creator,
          show_hover_info: true,
          created_at: contain.created_at.strftime('%d %B %Y') %>
      <% end %>
    </div>

    <% if current_user_owns?(@bookshelf) %>
      <div class='bookshelf-actions-container'>
        <%= link_to "Edit this bookshelf", edit_bookshelf_path(@bookshelf), class: 'btn btn--secondary btn--md' %> 
        <%= button_to 'Delete this Bookshelf', bookshelf_path(name: @bookshelf.name, creator: @bookshelf.creator), method: :delete, class: 'btn btn--negative btn--md'%>
      </div>
    <% end %>
  </div>
</div>
