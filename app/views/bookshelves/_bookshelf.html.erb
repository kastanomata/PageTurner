<div id="<%= dom_id bookshelf %>">
  <div class="bookshelf">
    <h2> <%= link_to bookshelf.name, bookshelf_path(bookshelf), class: "btn--link" %> </h2>
    <p>Created by: <%= link_to bookshelf.creator.nickname, user_path(bookshelf.creator), class: "btn--link" %></p>
    
    <div class="bookshelf-books-container">
      <% bookshelf.bookshelf_contains.includes(:book).each do |contain| %>
        <% book = contain.book %>
        <% next unless book %>
        
        <%= render 'books/book_card', 
          book: book,
          current_user: bookshelf.creator,
          bookshelf_actions: current_user_owns?(bookshelf) ? 
            button_to('Remove from Bookshelf', bookshelf_contain_path(contain), 
                    method: :delete, 
                    class: 'btn btn--delete', 
                    style: 'padding: 5px 10px') : nil,
          show_hover_info: true,
          created_at: contain.created_at.strftime('%d %B %Y') %>
      <% end %>
    </div>
  </div>
</div>
