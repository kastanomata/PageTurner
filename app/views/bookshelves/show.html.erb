<style>
  .bookshelf-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem; 
    position: relative;
  }

  .timeline-container {
    overflow-x: auto; 
    position: relative;
    z-index: 1;
  }

  .bookshelf-actions-container {
    width: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
  }
</style>

<div class="bookshelf-container">
  <%= render @bookshelf %>

  <% if current_user_owns?(@bookshelf) %>
    <div class='bookshelf-actions-container'>
      <%= link_to "Edit this bookshelf", edit_bookshelf_path(@bookshelf), class: 'btn btn--secondary btn--md' %> 
      <%= button_to 'Delete this Bookshelf', bookshelf_path(name: @bookshelf.name, creator: @bookshelf.creator), method: :delete, class: 'btn btn--negative btn--md'%>
    </div>
  <% end %>
  
  <% if @timeline_entries.any? %>
    <div class="timeline-container">
      <%= render 'timeline' %>
    </div>
  <% end %>
</div>



