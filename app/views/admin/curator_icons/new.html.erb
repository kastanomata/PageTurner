<h1>Upload New Curator Icon</h1>

<%= form_with(model: [:admin, @curator_icon], local: true) do |form| %>
  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: 'form-control', required: true %>
  </div>

  <div class="form-group">
    <%= form.label :icon %>
    <%= form.file_field :icon, class: 'form-control-file', required: true,
                      accept: 'image/png, image/jpeg, image/gif' %>
  </div>

  <%= form.submit 'Upload Icon', class: 'btn btn--secondary btn--sm' %>
  <%= link_to 'Cancel', admin_curator_icons_path, class: 'btn btn--negative btn--sm' %>
<% end %>