<% provide(:title, @title) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1><%= @user.nickname %></h1>
      <span><%= link_to "view my profile", @user %></span>
    </section>
    <section class="stats">
      <%= render 'shared/user_stats' %>
    </section>
  </aside>
  <div class="user-cards-container">
    <h3><%= @title %></h3>
    <% if @users.any? %>
      <% @users.each do |user| %>
      <div class="user-card">
        <div class="user-info">
          <%= user.nickname %> | <strong><%= user.email_address %></strong>
        </div>

        <div class="user-actions">
          <%= render_user_relationships_widget user %>
        </div>
      </div>
      <% end %>
      <%= will_paginate @users %>
    <% end %>
  </div>
</div>