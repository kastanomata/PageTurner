<% if authenticated? %>
  <div class="page-layout">
    <div class="left-section">
        <%= render_user_bookshelves Current.user %>
    </div>

    <div class="center-section">
    <div style="padding: 10px; border: #ddd 1px solid; border-radius: 8px; background-color: #549F93;">
     <div class="postcard-container">
        <div class="postcard">
          <!-- Lato sinistro -->
          <div class="postcard-left">
            <div class="book-image-container">
               <% if @post.book %>
                <%= render partial: "books/poster", locals: { book: @post.book }, class: "book-image" %>
              <% end %>
            </div>
          </div>

          <!-- Lato destro -->
          <div class="postcard-right">
            <div class="post-header">
              New Post
            </div>
            <div class="postcard-form-container">
              <form>
                 <%= render "posts/form", post: @post %>
              </form>
            </div>
          </div>
        </div>
      </div>

      <%= render_homepage_posts Current.user %>
      </div>
    </div>

    <div class="right-section">
      <div class="clubs-container">
        <%= render_user_clubs Current.user %>
      </div>
    </div>
  </div>

<% else %>
  <div class="container-big">
    <h1 >Welcome to the Home Page</h1>
    <p>Please sign in to access your account.</p>
    <%= link_to "Sign in", new_session_path, class: "btn-link-persiano" %>
  </div>    
<% end %>