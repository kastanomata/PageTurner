<% content_for :body_class do %>homepage<% end %>
<body class="<%= content_for?(:body_class) ? yield(:body_class) : '' %>">
<div class="page-layout">
  <div class="section left-section">
    <%= render_user_bookshelves Current.user %>
  </div>

  <div class="section center-section">
    <%= render "shared/postcard_form" %>
    <%= render_homepage_posts Current.user %>
  </div>

  <div class="section right-section">
    <div class="clubs-cards-container">
      <%= render_user_clubs Current.user %>
    </div>
  </div>
</div>