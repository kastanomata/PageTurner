<script>
  document.addEventListener('DOMContentLoaded', function() {
    const isbnInput = document.querySelector('.isbn-input');
    const searchResults = document.getElementById('isbn-search-results');
    let controller;

    function debounce(fn, delay) {
      let timeout;
      return (...args) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => fn.apply(this, args), delay);
      };
    }

    function updateBookDetails(book) {
      document.getElementById('post_title').value = `My thoughts about ${book.title}`;
      const coverImg = document.getElementById('book-cover-preview');
      
      // Use cover_url if provided, otherwise fall back to ISBN-based cover
      coverImg.src = book.cover_url || `https://covers.openlibrary.org/b/isbn/${book.isbn}-M.jpg`;
      coverImg.onerror = () => coverImg.src = coverImg.dataset.fallback;
      
      // You can also display the author if needed
      if (book.author) {
        // Update author field if you have one
      }
    }

    async function fetchFromOpenLibrary(isbn) {
      try {
        const response = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`);
        const data = await response.json();
        
        if (!data || !data[`ISBN:${isbn}`]) {
          throw new Error('Book not found in OpenLibrary');
        }
        
        const bookData = data[`ISBN:${isbn}`];
        return {
          title: bookData.title,
          isbn: isbn,
          cover_id: bookData.cover?.medium ? 
                   bookData.cover.medium.match(/id\/(\d+)-M/)[1] : null
        };
      } catch (error) {
        console.error('Error fetching from OpenLibrary:', error);
        throw error;
      }
    }

    const fetchHandler = debounce(async (isbn) => {
      try {
        const response = await fetch(`${isbnInput.dataset.fetchUrl}?isbn=${encodeURIComponent(isbn)}`);
        
        if (response.ok) {
          const book = await response.json();
          updateBookDetails(book);
        } else {
          throw new Error('Book not found');
        }
      } catch (error) {
        console.error('Error fetching book:', error);
        // Show error message to user
      }
    }, 500);

    const searchHandler = debounce(async (query) => {
      controller?.abort();
      controller = new AbortController();

      try {
        const response = await fetch(`${isbnInput.dataset.searchUrl}?query=${encodeURIComponent(query)}`, {
          signal: controller.signal
        });
        const books = await response.json();
        
        searchResults.innerHTML = books.map(book => `
          <div class="suggestion-item" 
               data-isbn="${book.isbn}"
               data-title="${book.title}">
            ${book.title} - ${book.isbn}
          </div>
        `).join('');
      } catch (error) {
        if (error.name !== 'AbortError') console.error(error);
      }
    }, 300);

    isbnInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      
      if (query.length >= 5) searchHandler(query);
      if (query.length === 13) fetchHandler(query);
    });

    searchResults.addEventListener('click', (e) => {
      const item = e.target.closest('.suggestion-item');
      if (item) {
        isbnInput.value = item.dataset.isbn;
        updateBookDetails({
          isbn: item.dataset.isbn,
          title: item.dataset.title
        });
        searchResults.innerHTML = '';
      }
    });
  });
</script>

<%= form_with(model: @post, local: true) do |form| %>
  <% if @post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% @post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<div class="postcard-container">
    <div class="postcard">
      <div class="postcard-left">
        <%= image_tag "", 
              id: "book-cover-preview", 
              class: "book-cover",
              data: { fallback: image_path('bookart_not_found.png') } %>
      </div>
      
      <div class="postcard-right">
        <div class="form-group">
          <%= form.label :isbn, "Book ISBN" %>
          <div class="isbn-input-container">
            <%= form.text_field :isbn, 
                  class: "form-control isbn-input",
                  data: { 
                    search_url: search_books_path, 
                    fetch_url: fetch_books_path 
                  } %>
          </div>
          <div class="search-results" id="isbn-search-results"></div>
        </div>

  <div class="form-group">
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :text, style: "display: block" %>
    <%= form.text_area :text, class: "form-control content-textarea", rows: 6 %>
  </div>

  <div>
    <%= form.submit "Post", class: "btn btn--primary btn--lg"%>
  </div>
<% end %>
    </div>
  </div>
</div>

