<div class="postcard-container">
  <div class="postcard">
    <!-- Left Side -->
    <div class="postcard-left">
      <%= book_image(@post.book, size: "poster", image_id: "book-cover-preview") %>
    </div>
    
    <!-- Right Side -->
    <div class="postcard-right">
      <%= render "posts/form", post: @post %>
    </div>
  </div>
</div>

<script>
function initPostISBNForm() {
  const isbnInput = document.querySelector('#post_isbn');
  const titleInput = document.querySelector('#post_title');
  const coverContainer = document.querySelector('#book-cover-preview');
  const coverPreview = document.querySelector('#book-cover-preview .book-image');
  const searchResults = document.querySelector('#isbn-search-results');
  let isProgrammaticChange = false;

  if (!isbnInput) return;

  const cleanISBN = (isbn) => isbn.replace(/[-\s]/g, '');

  const updateBookDetails = (book) => {
    if (book) {
      titleInput.value = "My thoughts about " + book.title;
      coverPreview.src = book.poster || '<%= asset_path('bookart_not_found.png') %>';
      coverContainer.classList.remove('book-image-container--not-found');
    } else {
      titleInput.value = '';
      coverPreview.src = '<%= asset_path('bookart_not_found.png') %>';
      coverContainer.classList.add('book-image-container--not-found');
    }
  };

  const handleISBNLookup = (isbn) => {
    const cleanedISBN = cleanISBN(isbn);
    
    if (cleanedISBN.length >= 5) {
      fetch(`/books.json?isbn=${encodeURIComponent(cleanedISBN)}`)
        .then(response => response.json())
        .then(books => {
          searchResults.innerHTML = books.length > 0 ? `
            <div class="search-results-list">
              ${books.map(book => `
                <div class="search-result-item" 
                     data-isbn="${book.isbn}"
                     data-title="${book.title}"
                     data-poster="${book.poster}">
                  ${book.title} (${book.isbn})
                </div>
              `).join('')}
            </div>` : '<div class="no-results">No books found</div>';
        });
    }

    if (cleanedISBN.length === 13) {
      fetch(`/books.json?isbn=${encodeURIComponent(cleanedISBN)}`)
        .then(response => response.json())
        .then(books => {
          if (books.length > 0) {
            updateBookDetails(books[0]);
          } else {
            updateBookDetails(null);
          }
        });
    }
  };

  isbnInput.addEventListener('input', function(e) {
    if (isProgrammaticChange) return;
    
    const isbn = e.target.value;
    searchResults.innerHTML = '';
    handleISBNLookup(isbn);
  });

  searchResults.addEventListener('click', function(e) {
    const resultItem = e.target.closest('.search-result-item');
    if (resultItem) {
      isProgrammaticChange = true;
      isbnInput.value = resultItem.dataset.isbn;
      updateBookDetails({
        title: resultItem.dataset.title,
        poster: resultItem.dataset.poster
      });
      searchResults.innerHTML = '';
      isProgrammaticChange = false;
    }
  });

  isbnInput.addEventListener('blur', function(e) {
    if (cleanISBN(e.target.value).length !== 13) {
      updateBookDetails(null);
    }
  });

  // Initialize state on page load
  if (!isbnInput.value) {
    updateBookDetails(null);
  }
}

document.addEventListener('DOMContentLoaded', initPostISBNForm);
</script>