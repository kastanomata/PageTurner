<% provide(:title, @title) %>
<div class="row">
  <aside class="col-md-4">
    <section class="club_info">
      <h1><%= @club.name %></h1>
      <span><%= link_to "view the bookclub", @club %></span>
    </section>
    <section class="stats">
      <%= render 'shared/club_stats' %>
    </section>
  </aside>
  <div class="col-md-8">
    <h3><%= @title %></h3>
    <% if @members.any? %>
      <% @members.each do |member| %>
      <div class="user-card">
        <div class="user-info">
          <%= link_to member.nickname, user_path(member) %>
        </div>
        <% if member != @club.curator %>
          <% if Current.user == @club.curator %>
            <div class="user-actions">
              <%= button_to "Delete Membership", 
                delete_membership_club_path(id: @club.id, member_id: member.id), 
                method: :delete, 
                class: "btn btn--negative btn--sm",
                form: { data: { turbo_confirm: "Are you sure?" } } %>
            </div>
          <% end %>
        <% end %>
      </div>
      <% end %>
      <%= will_paginate @members %>
    <% end %>
  </div>
</div>